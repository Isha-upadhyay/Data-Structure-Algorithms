class Solution {
  public:
       void solve(Node* node,vector<int> &res){
        if(!node)
        return;
        
        solve(node->left,res);
        res.push_back(node->data);
        solve(node->right,res);
    }
    // Function to return a list containing the inorder traversal of the tree.
    vector<int> inOrder(Node* root) {
        // Your code here
            vector<int> res;
        solve(root,res);
        return res;
    }
};
