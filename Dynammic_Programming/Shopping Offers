class Solution {
public:
    map<vector<int>, int> memo;
    int shoppingOffers(vector<int>& price, vector<vector<int>>& special, vector<int>& needs) {
        if(memo.count(needs)) return memo[needs];

        int n = price.size();
        
        //calculate normal price
        int minPrice = 0;
        for(int i=0;i<n;i++){
            minPrice += needs[i] * price[i];
        }\


        //special offer price 
        for(auto& offer: special){
            vector<int> newNeeds(n);
            bool valid = true;
            for(int i=0;i<n;i++){
                if(needs[i] < offer[i]){//offer zayda item de rha hai
                    valid = false;
                    break;
                }
                newNeeds[i] = needs[i] - offer[i];
            }
            if (valid){
                minPrice = min(minPrice, offer[n] + shoppingOffers(price, special, newNeeds));
            }
        }
        return memo[needs] = minPrice;
    }
};





                                                      
