class Solution {
public:
    const long long MOD = 1e9+7;
    int zigZagArrays(int n, int l, int r) {
         int m = r - l + 1; // Total numbers available
    
    // Edge case: if array length is 1, all numbers are valid
    if (n == 1) return m;

    // DP arrays:
    // up[j] = # of arrays ending at number j with last move UP
    // down[j] = # of arrays ending at number j with last move DOWN
    vector<long long> up(m + 1, 0);
    vector<long long> down(m + 1, 0);

    // Step 1: Initialize DP for arrays of length 2
    for (int j = 1; j <= m; j++) {
        up[j] = j - 1;      // Numbers smaller than j → valid UP
        down[j] = m - j;    // Numbers bigger than j → valid DOWN
    }

    // Temporary arrays for prefix sums and next DP
    vector<long long> prefix_up(m + 1, 0);
    vector<long long> prefix_down(m + 1, 0);
    vector<long long> next_up(m + 1, 0);
    vector<long long> next_down(m + 1, 0);

    // Step 2: DP transition for length >= 3
    for (int len = 3; len <= n; len++) {
        // Compute prefix sums for fast calculation
        prefix_up[0] = 0;
        prefix_down[0] = 0;
        for (int i = 1; i <= m; i++) {
            prefix_up[i] = (prefix_up[i - 1] + up[i]) % MOD;
            prefix_down[i] = (prefix_down[i - 1] + down[i]) % MOD;
        }

        // Calculate next DP arrays using prefix sums
        for (int j = 1; j <= m; j++) {
            // Next element UP → previous element must be smaller AND last move DOWN
            next_up[j] = prefix_down[j - 1];
            // Next element DOWN → previous element must be bigger AND last move UP
            next_down[j] = (prefix_up[m] - prefix_up[j] + MOD) % MOD; // +MOD to avoid negative
        }

        // Update current DP
        up = next_up;
        down = next_down;
    }

    // Step 3: Sum all valid arrays ending at each number
    long long ans = 0;
    for (int j = 1; j <= m; j++) {
        ans = (ans + up[j] + down[j]) % MOD;
    }

    return (int)ans;
    }
};
