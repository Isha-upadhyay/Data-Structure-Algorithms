class Solution {
  public:
    int maxSumIS(vector<int>& arr) {
        // Your code goes here
        int n = arr.size();
        int sum = 0;
        vector<int> dp(arr.size());
       
       for (int i = 0; i < n; i++) {
           dp[i] = arr[i];
            for (int j = 0; j < i; j++) {
                if (arr[j] < arr[i]) {
                    dp[i] = max(dp[i], dp[j] + arr[i]);
                }
            }
            sum = max(dp[i], sum);
        }
        return sum;
    }
};
