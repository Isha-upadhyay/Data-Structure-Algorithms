****** Approch-2:Odd even****

class Solution {
public:
    int rob(vector<int>& nums) {
        int n = nums.size(); 
        if(n==1) return nums[0];
       int oddSum = 0, evenSum = 0;
        for(int i=0;i<n;i++){
            if(i%2==0){
                evenSum =max(evenSum + nums[i], oddSum);
            }else{
                oddSum = max(oddSum + nums[i], evenSum);
            }
        }
        return  max( oddSum , evenSum);

    }
};




**** Approch-1:Using Dynamic Programming ******

class Solution {
public:
    int rob(vector<int>& nums) {
        int n = nums.size(); 
        if(n==1) return nums[0];
        vector<int> dp(n, 0);

        dp[0] = nums[0];
        dp[1] = max(nums[0], nums[1]); // agar 2 houses ho toh jisme jada paisa hai vo robber hoga

        for(int i=2;i<n;i++){ // 1, 2, 3, 1 
            dp[i] = max(dp[i-1], nums[i] + dp[i-2]) ; 
        }

        return dp[n-1];

    }
};


