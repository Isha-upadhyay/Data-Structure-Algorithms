class Solution {
  public:
    string decodedString(string &s) {
        // code here
       stack<pair<string, int>> st;//stack to store previous string and repeated count
       string curr_string = ""; // decoded string add  here
       int curr_num = 0; // digit milea+ga vo store krege
       
       for(char c :s){
           if(isdigit(c)){
               curr_num = curr_num * 10 + (c - '0');
           }else if(c == '['){
               st.push({curr_string, curr_num});
               curr_string = "";
               curr_num = 0;
           }else if(c == ']'){
            //   auto [prev_string , num] = st.top(); // pop last stored value
            //   st.pop();
              pair<string, int> topElement = st.top();
               st.pop();
              string prev_string = topElement.first;
              int num = topElement.second;
               string repeated_string = "";
               for(int i=0;i<num;i++){
                   repeated_string += curr_string;
               }
               curr_string = prev_string + repeated_string;
           }else{
               curr_string += c;
           }
       }
       return curr_string;
    }
 
};
