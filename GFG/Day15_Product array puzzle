class Solution {
  public:
    vector<int> productExceptSelf(vector<int>& arr) {
        // code here
        int n = arr.size();
        if(n==0) return {};
        vector<int> output(n, 1);
        
        
        
        int product = 1;
        for(int i=0;i<n;i++){
            output[i] = product;
            product*=arr[i];
        }
        product = 1;
        for(int i=n-1;i>=0;i--){
            output[i] *= product;
            product*=arr[i];
        }
       
        return output;
    }
};
