class Solution {
  public:
    vector<int> maxOfMins(vector<int>& arr) {
        // Your code here
        int n = arr.size();
        vector<int> left(n, -1), right(n, n); // Step 1: Initialize PSE & NSE arrays
        stack<int> s;

        // Step 2: Finding Previous Smaller Element (PSE)
        for (int i = 0; i < n; i++) {
            while (!s.empty() && arr[s.top()] >= arr[i]) {
                s.pop();
            }
            if (!s.empty()) {
                left[i] = s.top();
            }
            s.push(i);
        }

        // Clear stack for next computation
        while (!s.empty()) s.pop();

        // Step 3: Finding Next Smaller Element (NSE)
        for (int i = n - 1; i >= 0; i--) {
            while (!s.empty() && arr[s.top()] >= arr[i]) {
                s.pop();
            }
            if (!s.empty()) {
                right[i] = s.top();
            }
            s.push(i);
        }

        // Step 4: Initialize answer array
        vector<int> res(n, INT_MIN);

        // Step 5: Fill res using window size
        for (int i = 0; i < n; i++) {
            int windowSize = right[i] - left[i] - 1;
            res[windowSize - 1] = max(res[windowSize - 1], arr[i]);
        }

        // Step 6: Fill remaining values from right to left
        for (int i = n - 2; i >= 0; i--) {
            res[i] = max(res[i], res[i + 1]);
        }

        return res;
    }
};
