
class Solution {

  public:
    int maxWater(vector<int> &arr) {
        // code here
        long long maxArea = 0;
        int n = arr.size();
        int i = 0, j = n - 1;

       while (i < j) {
           long long height = min(arr[i], arr[j]);
           long long base = j - i;

           maxArea = max(maxArea, height * base); // Ensure both are long long

           if (arr[i] < arr[j]) {
               i++;
           } else {
              j--;
        }
    }

    return maxArea;

    }
};

