

class Solution {
  public:
    vector<int> countDistinct(vector<int> &arr, int k) {
        // code here.
        int n = arr.size();
        vector<int> res;
        unordered_map<int, int>freq;
        
        //ab store karege freq of element k tak map me
        for(int i=0; i<k; i++){
            freq[arr[i]] +=1;
        }    
        res.push_back(freq.size());
            
        for(int i=k; i<n; i++){
            freq[arr[i]]+=1;     // phir se ek nayi elenet start krege K(k=4) se map me dalege
            freq[arr[i-k]] -= 1;// purani window me se i-k ke count ko kam kar denge.
            
            if(freq[arr[i-k]] == 0){
                freq.erase(arr[i-k]); //jis bhi purane ele ki value 0 ho gyi hai use map se hta denge
            }
            res.push_back(freq.size());
        }
        return res;
        
    }
};



