
class Solution {
  public:
    vector<int> subarraySum(vector<int> &arr, int target) {
        // code here
        int start = 0, end = 0;
        int n = arr.size();
        vector<int> res;
        
        
        int currSum = 0;
        for(int i=0; i<n; i++){
            currSum += arr[i];
            
            
            if(currSum >= target){
                end = i;
                
                while(currSum > target && start < end ){
                currSum -= arr[start];
                start++;
                
                
                if(currSum == target ){
                res.push_back(start + 1);
                res.push_back(end + 1);
                return res;
                }
            }
        }
        return {-1};
    }
};

