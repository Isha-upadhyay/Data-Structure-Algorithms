class Solution {
  public:
    Node* rotate(Node* head, int k) {
        // Your code here
        if(head == nullptr || head->next == nullptr){
            return head;
        }
        
        Node* curr = head;
        int len = 1;
        while(curr->next!=nullptr){
            curr=curr->next;
            len+=1;
        }
        
        k%=len;
        if(k==0) return head;
        
        curr = head;
        for(int i=1;i<k;i++){
            curr=curr->next;
        }
        
        Node* newHead = curr->next;
        curr->next = nullptr;
        Node* temp = newHead;
        
        while(temp->next!=nullptr){
            temp = temp->next;
        }
        temp->next = head;
        
        return newHead;
    }
};
