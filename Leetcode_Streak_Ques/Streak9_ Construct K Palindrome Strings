class Solution {
public:
    bool canConstruct(string s, int k) {
        //edge cases
        if(s.length() < k) return false;
        if(s.length() == k) return true;

        vector<int> freq(26);
        int oddCount = 0;//oddcount ko initialize kar denge

        for(auto& ch:s) freq[ch -'a']++; //freq badha denge charater ki jiski 1 se jada hai

        for(int i=0; i<26; i++){
            if(freq[i] % 2 == 1){ // agar off freq mila hai toh pddCount badha denge
                oddCount++;
            }
        }
       return (oddCount <= k) ? true : false;

    }
};
