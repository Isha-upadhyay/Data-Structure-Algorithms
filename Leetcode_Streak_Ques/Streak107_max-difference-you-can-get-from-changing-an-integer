class Solution {
public:
    int maxDiff(int num) {
        
        string s = to_string(num);

        string maxS = s;

        for (char c : s) {
            if (c != '9') {
                for (char& x : maxS) {
                    if (x == c)
                        x = '9';
                }
                break;
            }
        }

        string minS = s;
        if (s[0] != '1') {
            char target = s[0];
            for (char& x : minS) {
                if (x == target)
                    x = '1';
            }
        } else {
            for (int i = 1; i < s.size(); i++) {
                if (s[i] != '0' && s[i] != '1') {
                    char target = s[i];
                    for (char& x : minS) {
                        if (x == target)
                            x = '0';
                    }
                    break;
                }
            }
        }
        return stoi(maxS) - stoi(minS);
    }
};
