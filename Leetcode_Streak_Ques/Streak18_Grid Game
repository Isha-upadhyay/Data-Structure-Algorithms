class Solution {
public:
    long long gridGame(vector<vector<int>>& grid) {
        long long firstRowRem = accumulate(begin(grid[0]), end(grid[0]), 0LL);
        long long secondRowRemSum = 0;
        long long minimizedRobot2Sum = LONG_LONG_MAX;

        for(int Robot1Col = 0; Robot1Col < grid[0].size(); Robot1Col++){
            firstRowRem -= grid[0][Robot1Col];

            long long maximum = max(firstRowRem,  secondRowRemSum);

            minimizedRobot2Sum =  min(maximum ,  minimizedRobot2Sum );
            secondRowRemSum += grid[1][Robot1Col];
            
        }
        return  minimizedRobot2Sum ;



    }
};
