class Solution {
public:
    long long countFairPairs(vector<int>& nums, int lower, int upper) {
        int n = nums.size();

        sort(nums.begin(), nums.end()); // nlogn

        long long result = 0;

        for (int i = 0; i < n; i++) { // O(n)
            auto idx =
                lower_bound(begin(nums) + i + 1, end(nums),
                            lower - nums[i]) - // log n
                begin(
                    nums); // gives the first ele NOT LESS then (lower-nums[i])

            int x = idx - 1 - i;
            idx =
                upper_bound(begin(nums) + i + 1, end(nums),
                            upper - nums[i]) - // log(n)
                begin(nums); // gives the first ele greater then (upper-nums[i])
            int y = idx - 1 - i;

            result += (y - x);
        }

        return result; // O(logn * n)
    }
};
