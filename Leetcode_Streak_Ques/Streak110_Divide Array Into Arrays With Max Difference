class Solution {
public:
    vector<vector<int>> divideArray(vector<int>& nums, int k) {
        int n = nums.size();
        sort(nums.begin(), nums.end());
        vector<vector<int>> arrays;

        for(int i=0;i<n;i+=3){
            if(nums[i+2] - nums[i] > k) return {};
            arrays.push_back({nums[i], nums[i+1], nums[i+2]});
        }
        return arrays;

       


        
    }
};

