class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        deque<int> dq; // yeh indexes store karega
    vector<int> result;

    for (int i = 0; i < nums.size(); i++) {
        //Window se bahar jo index chala gaya usko remove karo
        if (!dq.empty() && dq.front() == i - k) {
            dq.pop_front();
        }

        // Back se chhote elements nikal do kyunki unka chance khatam
        while (!dq.empty() && nums[dq.back()] < nums[i]) {
            dq.pop_back();
        }

        //  Naye index ko push karo
        dq.push_back(i);

        // Jab window ka size k ho jaye, tab result me max daalo
        if (i >= k - 1) {
            result.push_back(nums[dq.front()]);
        }
    }

    return result;
    }
};
