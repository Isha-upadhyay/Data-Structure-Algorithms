********* Using DFS **********

class Solution {
  public:
 bool isCycleDFS(int u, vector<vector<int>>& adj, vector<bool>& visited, int parent) {
    visited[u] = true;
    
    for (int &v : adj[u]) {  // Traverse all neighbors of v
        if(v == parent) continue;
        
        if(visited[v]) return true;
        
        if(isCycleDFS(v, adj, visited, u)) return true;
    }
    
    
    return false;
}

    // Function to detect cycle in an undirected graph.
    bool isCycle(vector<vector<int>>& adj) {
        // Code here
         int V = adj.size();
         vector<bool> visited(V, false);
    
    // Run DFS from each unvisited node
    for (int i = 0; i < V; i++) {
        if (!visited[i]) {
            if (isCycleDFS(i, adj, visited, -1)) {
                return true;  // Cycle detected
            }
        }
    }
    
    return false;
       
    }
};



********** Using BFS **********

class Solution {
  public:
 bool isCycleBFS(int u, vector<vector<int>>& adj, vector<bool>& visited) {
    queue<pair<int, int>> que;
    que.push({u, -1});
    visited[u] = true;
    
    while(!que.empty()){
        pair<int, int> p = que.front();
        que.pop();
        
        int source = p.first;
        int parent = p.second;
        
        for(int &v : adj[source]){
            if(visited[v] == false){
                visited[v] = true;
                que.push({v, source});
            } else if (v != parent){
                return true;
            }
        }
    }
    return false;
}

    // Function to detect cycle in an undirected graph.
    bool isCycle(vector<vector<int>>& adj) {
        // Code here
         int V = adj.size();
         vector<bool> visited(V, false);
    
    // Run DFS from each unvisited node
    for (int i = 0; i < V; i++) {
        if (!visited[i]) {
            if (isCycleBFS(i, adj, visited)) {
                return true;  // Cycle detected
            }
        }
    }
    
    return false;
       
    }
};
