class Solution {
  public:
  
    const int MAX_CHAR = 26;
    // Function to find the first non-repeating character in a string.
    char nonRepeatingChar(string &s) {
        // Your code here
        vector<int> freq(MAX_CHAR, 0);
        
        for(char ch:s){
            freq[ch-'a']++;
        }
        
        for(int i=0;i<s.length();++i){
            if(freq[s[i]-'a'] == 1){
                return s[i];
            }
        }
        return '$';
    }
};
