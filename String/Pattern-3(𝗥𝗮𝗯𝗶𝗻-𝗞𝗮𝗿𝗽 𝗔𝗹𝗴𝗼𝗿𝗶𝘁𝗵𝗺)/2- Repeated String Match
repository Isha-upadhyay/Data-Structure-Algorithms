class Solution {
public:
    bool rabinKarpMatch(const string& text, const string& pattern) {
        int n = text.size(), m = pattern.size();
        if (m > n)
            return false;

        int d = 256; // alphabet size
        int q = 101; // prime number
        int h = 1;

        for (int i = 0; i < m - 1; i++)
            h = (h * d) % q;

        int p_hash = 0, t_hash = 0;
        for (int i = 0; i < m; i++) {
            p_hash = (d * p_hash + pattern[i]) % q;
            t_hash = (d * t_hash + text[i]) % q;
        }

        for (int i = 0; i <= n - m; i++) {
            if (p_hash == t_hash) {
                if (text.compare(i, m, pattern) == 0) {
                    return true;
                }
            }
            if (i < n - m) {
                t_hash = (d * (t_hash - text[i] * h) + text[i + m]) % q;
                if (t_hash < 0)
                    t_hash += q;
            }
        }
        return false;
    }

    int repeatedStringMatch(string a, string b) {
        int count = ceil((double)b.length() / a.length());
        string s;

        for (int i = 0; i < count; i++)
            s += a;

        if (rabinKarpMatch(s, b))
            return count;

        s += a; // ek aur repeat check karo
        if (rabinKarpMatch(s, b))
            return count + 1;

        return -1;
    }
};
