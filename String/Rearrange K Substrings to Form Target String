class Solution {
public:
    bool isPossibleToRearrange(string s, string t, int k) {
        int n = s.size();
        
        int len = n/k;
        unordered_map<string, int> freqS, freqT;

        for(int i=0;i<n;i+=len){
            string sub = s.substr(i, len);
            freqS[sub]++;
        }

         for(int i=0;i<n;i+=len){
            string sub = t.substr(i, len);
            freqT[sub]++;
        }

        return freqS == freqT;
    }
};




