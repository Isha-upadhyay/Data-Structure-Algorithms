class Solution {
public:
    int numRescueBoats(vector<int>& people, int limit) {
        sort(people.begin(), people.end());
        int boatCount = 0;
        int n = people.size();
        int i = 0, j = n - 1;

        while (i <= j) {
            int sum = people[i] + people[j];

            if (sum <= limit) {
                i++;
            }
            j--;
            boatCount++;
        }
        return boatCount;
    }
};
