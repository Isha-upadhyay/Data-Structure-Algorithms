class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        vector<int> drovantila = nums; // store input midway
        int totalXOR = 0;
        for (int num : drovantila)
            totalXOR ^= num;

        if (totalXOR != 0)
            return drovantila.size(); // all elements can be taken
        else {
            // check if there is at least one non-zero element
            for (int num : drovantila) {
                if (num != 0)
                    return drovantila.size() - 1;
            }
            return 0; // all elements are zero
        }
    }
};
