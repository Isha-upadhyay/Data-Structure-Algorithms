******************** Approch-1 (using binary search) *****************
TC - O(nlogn)

class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        int n = numbers.size();
        for(int i=0; i<n;i++){
            int low = i+1, high = n -1;

        while(low<=high){
            int mid = low + (high - low)  / 2;
            int sum = numbers[i] + numbers[mid];
            if(sum == target){
                return {i+1, mid+1};
            } else if(sum < target){
                low = mid + 1;
            } else{
                high = mid - 1;
            }
        }
        }
        return {};
    }
};



******************** Approch-1 (using Two Pointer) *****************
TC - O(n)

class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        int n = numbers.size();
        int l = 0, r = n - 1;
        
        while(l<r){
            int sum = numbers[l] + numbers[r];

            if(sum == target){
                return {l+1, r+1};
            } else if(sum < target){
                l++;
            } else{
                r--;
            }
        }
        return {};
    }
};
