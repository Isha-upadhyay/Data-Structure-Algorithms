class Solution {
public:
    vector<string> validateCoupons(vector<string>& code,
                                   vector<string>& businessLine,
                                   vector<bool>& isActive) {

        unordered_map<string, int> businessOrder = {{"electronics", 0},
                                                    {"grocery", 1},
                                                    {"pharmacy", 2},
                                                    {"restaurant", 3}};

        vector < pair<int, string> >valid;

        regex validCodePattern("^[A-Za-z0-9_]+$");

        for (int i = 0; i < code.size(); i++) {
             if (!isActive[i]) continue;
            if (code[i].empty() || !regex_match(code[i], validCodePattern))
                continue;
            if (businessOrder.find(businessLine[i]) == businessOrder.end())
                continue;

            valid.push_back({businessOrder[businessLine[i]], code[i]});
        }

        sort(valid.begin(), valid.end(),
             [](const pair<int, string>& a, const pair<int, string>& b) {
                 if (a.first == b.first)
                     return a.second < b.second;
                 return a.first < b.first;
             });

        vector<string> result;
        for (auto& p : valid) {
            result.push_back(p.second);
        }

        return result;
    }
};
