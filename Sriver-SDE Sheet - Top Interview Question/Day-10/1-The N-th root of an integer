class Solution {
  public:
    long long power(int mid, int n, int m){
        long long ans = 1;
        for(int i=0;i<n;i++){
            ans*=mid;
            if(ans>m) return ans;
        }
        return ans;
    }
    int nthRoot(int n, int m) {
        // Code here.
        int left = 1, right= m;
        
        while(left <= right){
            int mid = left + (right - left) / 2;
            long long check = power(mid, n, m);
            
            if(check == m) return mid;
            else if(check < m) left = mid+ 1;
            else {
                right = mid - 1;
            }
        }
        return -1;
    }
};
