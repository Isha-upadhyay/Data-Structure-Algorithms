class Solution {
  public:
    bool canAllocate(vector<int>& arr, int k, int maxPages){
        int requiredStudents = 1;
        int currentPages = 0;
        
        for(int pages : arr){
            if(pages > maxPages) return false; // exceed maxlimit
            
            if(currentPages + pages > maxPages){
                requiredStudents++;
                currentPages = pages;
                
                if(requiredStudents > k){
                    return false;
                }
            }else{
                currentPages+=pages;
            }
            
        }
        return true;
    }
    int findPages(vector<int> &arr, int k) {
        // code here
        int n = arr.size(); 
        
        if(k>n) return -1;
        
        int low = *max_element(arr.begin(), arr.end());
        int high = accumulate(arr.begin(), arr.end(), 0);
        int res = high;
        
        while(low<= high){
            int mid = low + (high - low)/2;
            
            if(canAllocate(arr, k, mid)){
                res = mid;
                high = mid -1;
            }else{
                low = mid + 1;
            }
        }
        return res;
        
    }
};
