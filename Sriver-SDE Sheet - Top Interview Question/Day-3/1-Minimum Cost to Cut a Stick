class Solution {
public:
   int dp[103][103];
    int solve(vector<int>& cuts, int l, int r){
        if((r-l) < 2) return 0;

        if(dp[l][r] != -1) return dp[l][r];
        int result = INT_MAX;
        for(int idx = l+1; idx<=r-1; idx++){
            int cost = (cuts[r] - cuts[l]) + solve(cuts, l, idx) + solve(cuts, idx, r);
            result = min(result, cost);
        } 
        
        return dp[l][r] = result;
    }
    int minCost(int n, vector<int>& cuts) {
        sort(cuts.begin(), cuts.end());

        cuts.insert(begin(cuts), 0); // insert 0 at the beginning which is called l
        cuts.push_back(n); //  inseting n(7) at the end which is called r

        //which give length of  stick r-l

        memset(dp, -1, sizeof(dp));

        return solve(cuts, 0, cuts.size()-1);


    }
};
