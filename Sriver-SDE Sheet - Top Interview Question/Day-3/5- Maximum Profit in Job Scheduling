class Solution {
public:
    int n;
    vector<int> memo;
    // find the first job jiska starting point >= currentJob ka end point
    int getNextIndex(vector<vector<int>>& arr, int l, int currentJobEnd) {
        int r = n - 1;
        int result = n;


        while(l <= r) {
            int mid = l + (r - l) / 2;

            if (arr[mid][0] >= currentJobEnd) { // can take this job
                result = mid;
                r = mid - 1;
            } else {
                l = mid + 1;
            }
        }

        return result;
    }
    int solve(vector<vector<int>>& arr, int i) {
        if (i >= n)
            return 0;
        
        if (memo[i] != -1) return memo[i];

        int next = getNextIndex(arr, i + 1, arr[i][1]);
        int taken = arr[i][2] + solve(arr, next); // take current profit
        int notTaken = solve(arr, i + 1);

        return memo[i] = max(taken, notTaken);
    }

    int jobScheduling(vector<int>& startTime, vector<int>& endTime,
                      vector<int>& profit) {
        n = startTime.size();
        
        memo.assign(n + 1, -1);

        vector<vector<int>> arr(n, vector<int>(3, 0)); // {s, e, p}

        for (int i = 0; i < n; i++) {
            arr[i][0] = startTime[i];
            arr[i][1] = endTime[i];
            arr[i][2] = profit[i];
        }

        // sort acc to startTime
         sort(arr.begin(), arr.end(), [](const vector<int>& a, const vector<int>& b) {
            return a[0] < b[0];
        });

        return solve(arr, 0);

    }
};
