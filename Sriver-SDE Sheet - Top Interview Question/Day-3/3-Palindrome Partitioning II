class Solution {
public:
    int minCut(string s) {
        int n = s.length();

        // blue print code use
        vector<vector<bool>> dp(n, vector<bool>(n, false));
        // dp[i][j] = true/false  (s[i....j] substring is a palidrome or not)

        // length = 1 substring
        for (int i = 0; i < n; i++) {
            dp[i][i] = true; // s[i..i] is always a palindrome
        }

        // length >= 2
        for (int l = 2; l <= n; l++) {
            for (int i = 0; i < n - l + 1; i++) {
                int j = i + l - 1;

                if (l == 2) {
                    dp[i][j] = (s[i] == s[j]);
                } else {
                    dp[i][j] = ((s[i] == s[j]) && dp[i + 1][j - 1]);
                }
            }
        }

        vector<int> minCuts(n); // renamed to avoid conflict with dp

        for (int i = 0; i < n; i++) {
            if (dp[0][i] == true) { // s[0...i] is a palindrome
                minCuts[i] = 0;
            } else {
                minCuts[i] = INT_MAX;
                for (int k = 0; k < i; k++) {
                    if (dp[k + 1][i] == true && minCuts[k] + 1 < minCuts[i]) {
                        minCuts[i] = minCuts[k] + 1;
                    }
                }
            }
        }
        return minCuts[n - 1];
    }
};
