class Solution {
  public:
    vector<int> minPartition(int N) {
        // code here
       vector<int> ans;
        int coins[] = {1, 2, 5, 10, 20, 50, 100, 200, 500, 2000};  // denominations
        int n = 10;
        for (int i = n - 1; i >= 0; i--) {  // iterate from largest to smallest
            while (N >= coins[i]) {
                N -= coins[i];
                ans.push_back(coins[i]);
            }
        }
        return ans;
    }
};
