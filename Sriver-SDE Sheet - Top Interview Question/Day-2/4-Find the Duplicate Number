***********Approch-1************
class Solution {
public:
    int findDuplicate(vector<int>& nums) {
       int n = nums.size();
    vector<int> freq(n + 1, 0);  // Use vector instead of array

    for (int i = 0; i < n; i++) {
        if (freq[nums[i]] == 0) {
            freq[nums[i]] += 1;
        } else {
            return nums[i];  // Found the duplicate
        }
    }
    
    return -1;
    }
};



*****Approch-2 (linked list cycle) *********
class Solution {
public:
    int findDuplicate(vector<int>& nums) {
       int  slow = nums[0];
       int fast = nums[0];

       do{
        slow = nums[slow];
        fast = nums[nums[fast]];
       }
       while(slow != fast);
        slow = nums[0];
        while(slow !=fast){
        slow = nums[slow];
        fast = nums[fast];
       }
       return slow;
    }
};
